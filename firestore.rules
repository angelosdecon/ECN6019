rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bias Lab: anonymous classroom games. Open to anyone with the link until the date below.
    match /sessions/{session} {
      allow read, write: if request.time < timestamp.date(2027, 7, 1);
      match /{document=**} {
        allow read, write: if request.time < timestamp.date(2027, 7, 1);
      }
    }
  }
}
